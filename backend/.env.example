# Ambiente local (SQLite) — em produção na AWS, trocar por credenciais do RDS PostgreSQL
NODE_ENV=development
PORT=4000
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=7d

# Em produção (AWS RDS):
# DB_DIALECT=postgres
# DB_HOST=portal-cientifico.xxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=portal_cientifico
# DB_USER=postgres
# DB_PASSWORD=xxxxxxxx

# Armazenamento de imagens (produção — AWS S3)
# AWS_REGION=us-east-1
# S3_BUCKET=portal-cientifico-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
